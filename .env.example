# ============================================================
# Datakilde-konfiguration
# ============================================================
# Styrer hvilken implementering der bruges pr. datakilde.
# "mock" = indbygget testdata (ingen API-adgang nødvendig)
# "real" = rigtig API (kræver nøgler/certifikater herunder)
#
# Kilderne kan omstilles én ad gangen, efterhånden som du får
# adgang til de rigtige API'er.

DATASOURCE_DAWA=mock              # Åben og gratis. Klienten er implementeret OG live-testet - sæt til "real"
DATASOURCE_BBR=mock               # Kræver Datafordeler-bruger + tjenestebruger
DATASOURCE_VURDERING=mock         # Kræver Datafordeler-bruger (VUR/EJVF-tjenesten)
DATASOURCE_CVR=mock               # Kræver bruger hos Erhvervsstyrelsen (CVR system-til-system)
DATASOURCE_PLANDATA=mock          # Plandata.dk / kortforsyningen
DATASOURCE_MARKED=mock            # Finans Danmark boligmarkedsstatistik (åben)
DATASOURCE_STATSTIDENDE=mock      # Statstidende-API (gratis, kræver oprettelse)
DATASOURCE_EJENDOMSSOEGNING=mock  # Områdescreening: DAWA-adresser + BBR-filtrering (åben)

# ============================================================
# Datafordeler (BBR + Ejendomsvurdering)
#
# VIGTIGT - der findes TO adgangsmodeller på Datafordeleren:
#  1) Klassisk tjenestebruger (webbruger -> tjenestebruger med
#     brugernavn/adgangskode). Det er DEN, appens BBR REST-klient
#     bruger (?username=&password=). Husk at give tjenestebrugeren
#     adgang til tjenesten "BBR Publik".
#  2) Ny model: IT-system + API-nøgle/OAuth via "Datafordeler
#     Administration" (Bruger-ID + lang nøgle). Den virker til
#     GraphQL/Fildownload på den nye platform - IKKE til den
#     klassiske REST-tjeneste. REST udfases ultimo 2026, så på
#     sigt skal klienten flyttes til den nye model.
# ============================================================
DATAFORDELER_USERNAME=
DATAFORDELER_PASSWORD=

# ============================================================
# CVR (Erhvervsstyrelsen system-til-system-adgang)
# Ansøg via https://datacvr.virk.dk
# ============================================================
CVR_API_USERNAME=
CVR_API_PASSWORD=

# ============================================================
# Statstidende (gratis API - opret adgang på statstidende.dk)
# ============================================================
STATSTIDENDE_API_KEY=
